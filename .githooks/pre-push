#!/bin/bash
# MacPower pre-push hook: dead-code check using periphery.
# Enable with:  make hooks   (sets core.hooksPath to .githooks)
set -euo pipefail

echo "pre-push: running periphery dead-code scan…"

if command -v periphery >/dev/null 2>&1; then
    # --strict: exit non-zero when unused code is found (without it periphery
    # exits 0 and only scan errors would block). `-- --build-system native`:
    # SwiftPM 6.4's default Swift Build engine writes no index store for
    # periphery to read; drop it once periphery supports Swift Build.
    if ! periphery scan --quiet --strict -- --build-system native; then
        echo "✗ periphery found unused code or failed to scan (see above). Fix before pushing." >&2
        exit 1
    fi
else
    echo "  (periphery not installed — skipping; 'brew install periphery')"
fi

echo "✓ pre-push checks passed"
